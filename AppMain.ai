   var ZufallsQuelle zq;
   var char puffer[4];

   zq.gebe(puffer,4);

   var int r = 0;
   for(var int i=0; i < 4; i++)
   { 
     r = r + cast(int,puffer[i]); 
   }
   


   if(r < 0) { r = r * -1; }

   r = r % 1000;

   var int t = -1;

   var Input input;

   while ( r != t )
   {
     pfc.fstr("Rate die Zahl von 0 bis 999").pr();
     var String_16 ts;
     input.getString(ts);
     t = ts.asNumber();
     if( t  < r)
     { pfc.fstr("zu klein").pr(); }
     if( t  > r)
     { pfc.fstr("zu gross").pr(); }
     if( t  == r)
     { pfc.fstr("Richtig !").pr(); }
     
   }

   return 1;
}

